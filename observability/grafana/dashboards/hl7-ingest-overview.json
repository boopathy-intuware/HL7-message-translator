{
  "title": "HL7 Ingest Overview",
  "uid": "hl7-ingest-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "tags": ["hl7"],
  "panels": [
    {
      "id": 1,
      "title": "Messages ingested (rate/5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(hl7_messages_ingested_total[5m])) by (message_type)",
          "legendFormat": "{{message_type}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Parse failure rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(hl7_parse_failures_total[5m])) by (message_type) / sum(rate(hl7_messages_ingested_total[5m])) by (message_type)",
          "legendFormat": "{{message_type}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Processing latency (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(hl7_processing_duration_seconds_bucket[5m])) by (le, message_type))",
          "legendFormat": "p50 {{message_type}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(hl7_processing_duration_seconds_bucket[5m])) by (le, message_type))",
          "legendFormat": "p95 {{message_type}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(hl7_processing_duration_seconds_bucket[5m])) by (le, message_type))",
          "legendFormat": "p99 {{message_type}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Recent backend logs (OTel via Loki)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=\"hl7-backend\"}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Recent traces (OTel via Tempo)",
      "type": "table",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"hl7-backend\"}",
          "limit": 20
        }
      ]
    }
  ]
}
